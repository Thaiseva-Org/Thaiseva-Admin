# Frontend Vite env — copy to .env (safe to expose VITE_ Firebase web config)
VITE_apiKey=
VITE_authDomain=
VITE_projectId=
VITE_storageBucket=
VITE_messagingSenderId=
VITE_appId=
VITE_measurementId=

# Register this reCAPTCHA Enterprise site key with Firebase App Check.
VITE_APP_CHECK_SITE_KEY=
# Local OTP Functions emulator only (ignored in production builds).
VITE_OTP_USE_EMULATOR=false

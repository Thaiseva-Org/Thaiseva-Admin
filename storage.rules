rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function authenticated() { return request.auth != null; }
    // Single-user admin dashboard: Any authenticated admin session has admin privileges.
    function isAdmin() {
      return authenticated();
    }
    function isFoodAdmin() {
      return authenticated();
    }
    function owner(uid) { return authenticated() && request.auth.uid == uid; }
    function sized(bytes) { return request.resource == null || request.resource.size < bytes; }
    function image() { return request.resource == null || request.resource.contentType.matches('image/.*'); }
    function documentUpload() {
      return sized(25 * 1024 * 1024) && (request.resource == null ||
        request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }

    // Public reads are explicit and never overlap private documents.
    match /site-media/{file=**} {
      allow read: if true;
      allow write: if isAdmin() && sized(50 * 1024 * 1024);
    }
    match /{folder}/{file=**} {
      allow read: if folder in ['images', 'restaurantImages', 'blogImages', 'hotelImages', 'serviceImages'];
      allow write: if folder in ['images', 'restaurantImages', 'blogImages', 'hotelImages', 'serviceImages'] &&
        (isAdmin() || image()) && sized(25 * 1024 * 1024);
    }
    // Root-level catalog/dashboard media (e.g. {timestamp}-file uploaded from admin portal)
    match /{fileName} {
      allow read: if true;
      allow write: if (isAdmin() || image()) && sized(25 * 1024 * 1024);
    }
    match /users/{uid}/{file=**} {
      allow read: if owner(uid) || isAdmin();
      allow write: if (owner(uid) || isAdmin()) && sized(25 * 1024 * 1024);
    }
    // Partner and hotel media
    match /{collection}/{uid}/{folder}/{file=**} {
      allow read: if collection in ['partners', 'hotels', 'HotelDB'];
      allow write: if collection in ['partners', 'hotels', 'HotelDB'] &&
        (owner(uid) || isAdmin()) && sized(25 * 1024 * 1024);
    }
    match /{collection}/{uid}/{fileName} {
      allow read: if collection in ['partners', 'hotels', 'HotelDB'];
      allow write: if collection in ['partners', 'hotels', 'HotelDB'] &&
        (owner(uid) || isAdmin()) && sized(25 * 1024 * 1024);
    }
    match /{collection}/{uid}/media/{file=**} {
      allow read: if collection in ['partners', 'hotels', 'HotelDB'];
      allow write: if collection in ['partners', 'hotels', 'HotelDB'] &&
        (owner(uid) || isAdmin()) && sized(25 * 1024 * 1024);
    }
    match /restaurants/{uid}/documents/{file=**} {
      allow read: if owner(uid) || isAdmin() || isFoodAdmin();
      allow write: if (owner(uid) || isAdmin() || isFoodAdmin()) && documentUpload();
    }
    match /restaurants/{uid}/{fileName} {
      allow read: if true;
      allow write: if (owner(uid) || isAdmin() || isFoodAdmin()) && sized(25 * 1024 * 1024);
    }
    match /restaurants/{uid}/{folder}/{file=**} {
      allow read: if folder in ['media', 'images', 'menu', 'profile', 'items'];
      allow write: if (owner(uid) || isAdmin() || isFoodAdmin()) && sized(25 * 1024 * 1024);
    }
    match /applications/{applicationId}/{file=**} {
      allow read: if isAdmin() || isFoodAdmin();
      allow write: if isAdmin() || isFoodAdmin();
    }
    // Chat media: readable by authenticated users, writable by sender or admin
    match /{folder}/{uid}/{file=**} {
      allow read: if folder in ['chat', 'chats', 'chatMedia'] && authenticated();
      allow write: if folder in ['chat', 'chats', 'chatMedia'] && (owner(uid) || isAdmin() || isFoodAdmin()) && sized(25 * 1024 * 1024);
    }
    match /{file=**} {
      allow read, write: if false;
    }
  }
}

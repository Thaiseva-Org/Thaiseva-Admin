rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // --- HELPER FUNCTIONS ---
    function isAuthenticated() {
      return request.auth != null;
    }

    // --- RULES ---
    match /{allPaths=**} {
      // Allow public read for all files (catalogs, blogs, hotel images, etc.)
      allow read: if true;
      
      // Authenticated users upload profile, service, room, package, and chat files.
      allow write: if isAuthenticated();
    }
  }
}

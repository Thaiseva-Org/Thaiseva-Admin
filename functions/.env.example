# Copy to functions/.env and fill values. DO NOT commit functions/.env
EMAIL_USER=
EMAIL_PASS=

# Zoho transactional OTP email. Select the endpoint shown in your Zoho account.
ZOHO_MAIL_API_URL=https://api.zeptomail.com/v1.1/email
OTP_BUSINESS_DOMAIN=thaiseva.com
OTP_FROM_EMAIL=no-reply@thaiseva.com
OTP_SENDER_NAME=Thaiseva
OTP_REPLY_TO_EMAIL=support@thaiseva.com
# Keep true for production. Use false only with local emulators.
OTP_ENFORCE_APP_CHECK=true
# ZOHO_MAIL_API_KEY and OTP_HASH_KEY belong in Secret Manager, NOT this file.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Stripe (test or live) — server only
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://thaiseva.com/booking/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://thaiseva.com/booking/cancel

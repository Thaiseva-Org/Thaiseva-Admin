{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "test": "npm run build && node --test test/otp.test.cjs",
    "test:otp:integration": "npm run build && firebase emulators:exec --config ../firebase.otp-test.json --project demo-thaiseva-otp --only firestore,auth \"node --test test/otp.integration.cjs\"",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "dotenv": "^16.4.5",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.3",
    "graphql": "^17.0.2",
    "nodemailer": "^6.9.13",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "@types/nodemailer": "^6.4.14",
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.25.4",
    "eslint-plugin-prettier": "^5.1.3",
    "firebase-functions-test": "^3.1.0",
    "typescript": "^5.9.3"
  },
  "private": true
}

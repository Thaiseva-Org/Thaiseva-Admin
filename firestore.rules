rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "Admin";
    }

    // Restrict write access to partners collection to admins only
    match /partners/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Allow read/write for all other collections for authenticated users
    // This allows the app to function for logged-in staff while preventing anonymous public access.
    // The previous rule expired on Dec 31, 2025.
    match /{collection}/{document=**} {
      allow read, write: if request.auth != null && collection != 'partners';
    }
  }
}
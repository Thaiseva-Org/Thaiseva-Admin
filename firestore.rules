rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // HELPER FUNCTIONS
    // ==========================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Master Admin: checked via hardcoded emails, custom claim, or Firestore role
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email in [
          "admin@gmail.com",
          "thaiseva_admin@gmail.com"
        ] ||
        request.auth.token.admin == true ||
        getUserData().get('role', null) in ["Admin", "admin", "Sub Admin"] ||
        (getUserData().get('isMasterAdmin', null) != null && getUserData().get('isMasterAdmin', null) == true)
      );
    }

    // Restaurant Admin: checked via Firestore user profile flag
    function isRestaurantAdmin() {
      return isAuthenticated() && (
        getUserData().get('isRestaurantAdmin', null) != null &&
        getUserData().get('isRestaurantAdmin', null) == true
      );
    }

    // Ownership check on EXISTING resource (read / update / delete)
    function isOwner(userIdField) {
      return isAuthenticated() && (
        resource == null ||
        resource.data.get(userIdField, null) == request.auth.uid ||
        resource.data.get('userId', null) == request.auth.uid ||
        resource.data.get('authUid', null) == request.auth.uid ||
        resource.data.get('uid', null) == request.auth.uid ||
        resource.data.get('providerUid', null) == request.auth.uid ||
        resource.data.get('hotelUid', null) == request.auth.uid ||
        resource.data.get('restaurantUid', null) == request.auth.uid
      );
    }

    // Ownership check on INCOMING resource (create / update)
    function ownsIncoming(userIdField) {
      return isAuthenticated() && (
        request.resource.data.get(userIdField, null) == request.auth.uid ||
        request.resource.data.get('userId', null) == request.auth.uid ||
        request.resource.data.get('authUid', null) == request.auth.uid ||
        request.resource.data.get('uid', null) == request.auth.uid ||
        request.resource.data.get('providerUid', null) == request.auth.uid ||
        request.resource.data.get('hotelUid', null) == request.auth.uid ||
        request.resource.data.get('restaurantUid', null) == request.auth.uid
      );
    }

    // Email-based ownership (for bookings that store email instead of uid)
    function isEmailOwner() {
      return isAuthenticated() && (
        resource == null ||
        resource.data.get('email', null) == request.auth.token.email ||
        resource.data.get('guestEmail', null) == request.auth.token.email ||
        resource.data.get('userEmail', null) == request.auth.token.email
      );
    }

    // Safe partner self-registration: role must be "Partner", status "Pending", not suspended
    function isSafeUserCreate() {
      return request.resource.data.role == "Partner" &&
        request.resource.data.status == "Pending" &&
        request.resource.data.isMasterAdmin != true &&
        request.resource.data.isRestaurantAdmin != true &&
        request.resource.data.isSuspended != true;
    }

    // Safe self-update: user cannot modify their own role, status, or suspension flag
    function isSafeUserUpdate(userId) {
      return request.auth.uid == userId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.isSuspended == resource.data.isSuspended &&
        request.resource.data.get('isMasterAdmin', false) == resource.data.get('isMasterAdmin', false) &&
        request.resource.data.get('isRestaurantAdmin', false) == resource.data.get('isRestaurantAdmin', false);
    }

    // ==========================================
    // 1. PUBLIC COLLECTIONS (Read-Only for everyone, Write for Admin)
    // ==========================================
    match /{collection}/{docId} {
      allow read: if collection in [
        'BlogDB', 'ServiceDB', 'HotelDB', 'sightseeingPackages',
        'sightseeingPackagesDetails', 'hotelPackages', 'hotelPackageDetails',
        'TestimonialDB', 'FaqDB', 'OfferDB', 'ContentDB', 'localServices',
        'restaurants', 'carDetails', 'foodMenu', 'coupons', 'partners',
        'TourDB', 'travelServices',
        // App-specific public / static content
        'Thaiseva_terms',
        'food_items'
      ];
      allow write: if isAdmin();
    }

    // ==========================================
    // 2. APP SETTINGS / CONFIG
    // ==========================================
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==========================================
    // 3. SUB-COLLECTIONS OF PUBLIC ITEMS
    // ==========================================
    match /HotelDB/{hotelId}/rooms/{roomId} {
      allow read: if true;
      allow write: if isAdmin() || (isAuthenticated() && request.auth.uid == hotelId);
    }

    match /restaurants/{ownerId}/restaurantDetails/{restaurantId} {
      allow read: if true;
      allow write: if isAdmin() || (isAuthenticated() && request.auth.uid == ownerId);
    }

    // ==========================================
    // 4. CONTACT MESSAGES
    // ==========================================
    match /ContactMessages/{docId} {
      allow read, write: if isAdmin();
      allow create: if true; // Allow public to send messages
    }

    // Legacy website contact collection
    match /ContusDB/{docId} {
      allow read, write: if isAdmin();
      allow create: if true;
    }

    // Explicit FAQ & Testimonial rules (also in public list, but explicit for clarity)
    match /FaqDB/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /TestimonialDB/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==========================================
    // 5. USER PROFILES
    // ==========================================
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAdmin() || (isAuthenticated() && request.auth.uid == userId && isSafeUserCreate());
      allow update: if isAdmin() || (isAuthenticated() && isSafeUserUpdate(userId));
      allow delete: if isAdmin();
    }

    // Some parts of the app also reference a capitalised "Users" collection
    match /Users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAdmin() || (isAuthenticated() && request.auth.uid == userId && isSafeUserCreate());
      allow update: if isAdmin() || (isAuthenticated() && isSafeUserUpdate(userId));
      allow delete: if isAdmin();
    }

    // Per-user notification sub-collections
    match /users/{userId}/notifications/{notificationId} {
      allow read, write, delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    match /Users/{userId}/notifications/{notificationId} {
      allow read, write, delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // ==========================================
    // 6. NOTIFICATIONS
    // ==========================================
    match /notifications/{docId} {
      allow read, write, delete: if isAdmin();
    }

    match /notifications/users/{userId}/{messageId} {
      allow read, write, delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    match /notifications/admin/messages/{messageId} {
      allow read, write, delete: if isAdmin();
    }

    // App-level notifications with type grouping: notifications/{type}/{targetId}/{notifyId}
    match /notifications/{type}/{targetId}/{notifyId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == targetId || targetId == "RestAdmin" || isAdmin()
      );
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        request.auth.uid == targetId || targetId == "RestAdmin" || isAdmin()
      );
    }

    // ==========================================
    // 7. RESTAURANT METADATA (dedicated rule)
    // ==========================================
    match /restaurants/{restaurantId} {
      allow read: if true;
      allow create: if isAdmin() || (
        isAuthenticated() && request.auth.uid == restaurantId &&
        (!request.resource.data.keys().hasAll(['status']) || request.resource.data.status == 'Pending')
      );
      allow update: if isAdmin() || (
        isAuthenticated() && request.auth.uid == restaurantId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'id'])
      );
      allow delete: if isAdmin();
    }

    // ==========================================
    // 8. FOOD ITEMS (sub-collection per restaurant)
    // ==========================================
    match /food_items/{restaurantId}/items/{itemId} {
      allow read: if true;
      allow write: if isAdmin() || isUser(restaurantId) || isRestaurantAdmin();
    }

    // ==========================================
    // 9. ORDERS
    // ==========================================
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isOwner('uid') ||
        request.auth.uid == resource.data.get('Restaurant', {}).get('ownerId', null) ||
        (resource.data.get('Receiver', null) != null && request.auth.uid == resource.data.Receiver.id)
      );
      allow create: if isAuthenticated() && ownsIncoming('uid');
      allow update: if isAuthenticated() && (
        isAdmin() ||
        isOwner('uid') ||
        request.auth.uid == resource.data.get('Restaurant', {}).get('ownerId', null)
      );
      allow delete: if isAdmin();
    }

    // ==========================================
    // 10. CART
    // ==========================================
    match /cart/{cartId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == cartId || isAdmin());
    }

    // ==========================================
    // 11. REVIEWS
    // ==========================================
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || isOwner('uid');
    }

    // ==========================================
    // 12. FEEDBACK & RATINGS
    // ==========================================
    match /feedbackandratings/{docId} {
      allow read: if isAdmin();
      allow create: if true; // Allow guests/users to submit feedback
      allow update, delete: if isAdmin();
    }

    // ==========================================
    // 13. T2T WORLD
    // ==========================================
    match /T2T_world/{docId}/{subPath=**} {
      allow read: if true;
      allow write: if isAdmin() || isAuthenticated();
    }

    // ==========================================
    // 14. DINE-IN BOOKINGS / TABLE RESERVATIONS
    // ==========================================
    match /dineInBookings/{bookingId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isOwner('uid') ||
        request.auth.uid == resource.data.get('ownerId', null) ||
        request.auth.uid == resource.data.get('userId', null)
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        isAdmin() ||
        isOwner('uid') ||
        request.auth.uid == resource.data.get('ownerId', null)
      );
      allow delete: if isAdmin();
    }

    // ==========================================
    // 15. GENERIC BOOKINGS (hotel widget bookings)
    // ==========================================
    match /bookings/{bookingId} {
      allow create: if isAuthenticated();
      allow read, update: if isAdmin() || isOwner('uid');
      allow delete: if isAdmin();
    }

    // ==========================================
    // 16. TRAVEL / CAR / VAN BOOKING COLLECTIONS
    // ==========================================
    match /{collection}/{docId} {
      allow create: if collection in [
        'hotelBookingData', 'travelBookingDetails', 'car_bookings',
        'self_driving_bookings', 'vanBookings'
      ] && isAuthenticated();

      allow read: if collection in [
        'hotelBookingData', 'travelBookingDetails', 'car_bookings',
        'self_driving_bookings', 'vanBookings'
      ] && (isOwner('userId') || isOwner('uid') || isEmailOwner() || isAdmin());

      allow update: if isAdmin() || (
        collection in [
          'hotelBookingData', 'travelBookingDetails', 'car_bookings',
          'self_driving_bookings', 'vanBookings'
        ] && (isOwner('userId') || isOwner('uid') || isEmailOwner())
      );
      allow delete: if isAdmin();
    }

    // ==========================================
    // 17. PARTNER-OWNED SERVICE DATA
    // ==========================================
    match /partners/{partnerId} {
      allow read: if true;
      allow create, update: if isAdmin() || (isAuthenticated() && request.auth.uid == partnerId);
      allow delete: if isAdmin();
    }

    match /drivers/{driverId} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == driverId);
      allow create, update: if isAdmin() || (isAuthenticated() && request.auth.uid == driverId);
      allow delete: if isAdmin();
    }

    // Normalized Taxi / Van operations. All mutations go through callable
    // functions so lifecycle, duplicate-registration, and conflict checks run
    // with server-side validation. Admin clients only subscribe to these docs.
    match /transportCompanies/{companyId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /transportDrivers/{driverId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /transportVehicles/{vehicleId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /transportEarnings/{ledgerId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /transportNotificationEvents/{eventId} {
      allow read, write: if false;
    }

    match /HotelDB/{hotelId} {
      allow read: if true;
      allow create, update: if isAdmin() || (isAuthenticated() && request.auth.uid == hotelId);
      allow delete: if isAdmin();
    }

    match /foodMenu/{menuId} {
      allow read: if true;
      allow create: if isAdmin() || ownsIncoming('restaurantUid');
      allow update, delete: if isAdmin() || isOwner('restaurantUid');
    }

    match /localServices/{serviceId} {
      allow read: if true;
      allow create: if isAdmin() || ownsIncoming('providerUid');
      allow update, delete: if isAdmin() || isOwner('providerUid');
    }

    match /hotelPackageDetails/{packageId} {
      allow read: if true;
      allow create: if isAdmin() || ownsIncoming('hotelUid');
      allow update, delete: if isAdmin() || isOwner('hotelUid');
    }

    match /hotelPackages/{packageId} {
      allow read: if true;
      allow create: if isAdmin() || ownsIncoming('hotelUid');
      allow update, delete: if isAdmin() || isOwner('hotelUid');
    }

    match /allRequirements/{requirementId} {
      allow read: if isAdmin() || isOwner('providerUid');
      allow create: if isAdmin() || ownsIncoming('providerUid');
      allow update, delete: if isAdmin() || isOwner('providerUid');
    }

    match /travelRequirements/{requirementId} {
      allow read: if isAdmin() || isOwner('providerUid');
      allow create: if isAdmin() || ownsIncoming('providerUid');
      allow update, delete: if isAdmin() || isOwner('providerUid');
    }

    match /general_partners/{partnerId}/assignedPackages/{assignmentId} {
      allow read, write: if isAdmin();
    }

    // ==========================================
    // 18. EARNINGS / REVENUE TRACKING
    // ==========================================

    // App-style earnings: Earnings/{targetId}/{subcollection}/{docId}
    match /Earnings/{targetId}/{subcollection}/{docId} {
      allow read: if isAuthenticated() && (request.auth.uid == targetId || isAdmin());
      allow write: if isAuthenticated() && (
        isAdmin() ||
        (request.auth.uid == targetId && targetId != "Admin")
      );
    }

    // Admin dashboard master earnings
    match /MasterEarnings/Admin/{type}/Earnings/{earningsType}/{docId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin();
    }

    // Partner-scoped master earnings
    match /MasterEarnings/{type}/{partnerId}/Earnings/{earningsType}/{docId} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == partnerId);
      allow create, update: if isAdmin() || (isAuthenticated() && request.auth.uid == partnerId);
    }

    // ==========================================
    // 19. SELF-DRIVE CONDITIONS / DOCUMENTS
    // ==========================================
    match /self_drive_conditions_and_documents/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==========================================
    // 20. ADMIN-ONLY COLLECTIONS
    // ==========================================
    match /counters/{counterId} {
      allow read, write: if isAdmin();
    }

    match /acceptedRestaurants/{restaurantId} {
      allow read, write: if isAdmin();
    }

    match /restroRequests/{restaurantId} {
      allow read, write: if isAdmin();
    }

    match /agents/{agentId} {
      allow read, write: if isAdmin();
    }

    match /RestAdmin/{docId} {
      allow read, write: if isAdmin();
    }

    match /{collection}/{docId} {
      allow read, write: if isAdmin() && collection in [
        'agents', 'drivers', 'shops', 'clubs', 'allRequirements',
        'travelRequirements', 'partner_invoices', 'manage_partners',
        'general_partners', 'vanCompanies', 'settings', 'statistics',
        'hotel_statistics', 'DeletionRequests', 'counters',
        'acceptedRestaurants', 'restroRequests', 'RestAdmin'
      ];
    }

    // ==========================================
    // 21. CHAT SYSTEM
    // ==========================================
    match /chatRooms/{roomId} {
      allow read, write: if isAuthenticated();
    }

    match /chats/{chatId} {
      allow read, write: if isAuthenticated();
    }

    match /messages/{messageId} {
      allow read, write: if isAuthenticated();
    }

    match /calls/{callId} {
      allow read, write: if isAuthenticated();
    }

    // ==========================================
    // DEFAULT: DENY EVERYTHING ELSE
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email in [
          "admin@gmail.com",
          "thaiseva_admin@gmail.com"
        ] ||
        request.auth.token.admin == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "Admin" ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "Sub Admin"
      );
    }

    function isOwner(userIdField) {
      return isAuthenticated() && (
        resource == null ||
        resource.data[userIdField] == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        resource.data.authUid == request.auth.uid ||
        resource.data.uid == request.auth.uid ||
        resource.data.providerUid == request.auth.uid ||
        resource.data.hotelUid == request.auth.uid ||
        resource.data.restaurantUid == request.auth.uid
      );
    }

    function ownsIncoming(userIdField) {
      return isAuthenticated() && (
        request.resource.data[userIdField] == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.authUid == request.auth.uid ||
        request.resource.data.uid == request.auth.uid ||
        request.resource.data.providerUid == request.auth.uid ||
        request.resource.data.hotelUid == request.auth.uid ||
        request.resource.data.restaurantUid == request.auth.uid
      );
    }

    function isSafeUserCreate() {
      return request.resource.data.role == "Partner" &&
        request.resource.data.status == "Pending" &&
        request.resource.data.isSuspended != true;
    }

    function isSafeUserUpdate(userId) {
      return request.auth.uid == userId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.isSuspended == resource.data.isSuspended;
    }

    // --- PUBLIC COLLECTIONS (Read-Only) ---
    match /{collection}/{docId} {
      allow read: if collection in [
        'BlogDB', 'ServiceDB', 'HotelDB', 'sightseeingPackages',
        'sightseeingPackagesDetails', 'hotelPackages', 'hotelPackageDetails',
        'TestimonialDB', 'FaqDB', 'OfferDB', 'ContentDB', 'localServices',
        'restaurants', 'carDetails', 'foodMenu', 'coupons', 'partners',
        'TourDB', 'travelServices',

        // App uses these as public/static content
        'Thaiseva_terms',
        // Sometimes used as a public catalog container in code
        'food_items'
      ];
      allow write: if isAdmin();
    }

    // --- APP SETTINGS / CONFIG ---
    // Used by the app for features like "whats_new" etc.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Allow reading sub-collections of public items
    match /HotelDB/{hotelId}/rooms/{roomId} {
      allow read: if true;
      allow write: if isAdmin() || (isAuthenticated() && request.auth.uid == hotelId);
    }

    match /restaurants/{ownerId}/restaurantDetails/{restaurantId} {
      allow read: if true;
      allow write: if isAdmin() || (isAuthenticated() && request.auth.uid == ownerId);
    }

    // --- CONTACT MESSAGES ---
    match /ContactMessages/{docId} {
      allow read, write: if isAdmin();
      allow create: if true; // Allow public to send messages
    }

    match /FaqDB/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /TestimonialDB/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- USER DATA ---
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAdmin() || (isAuthenticated() && request.auth.uid == userId && isSafeUserCreate());
      allow update: if isAdmin() || (isAuthenticated() && isSafeUserUpdate(userId));
      allow delete: if isAdmin();
    }

    // Some parts of the app also reference a capitalized Users collection.
    match /Users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAdmin() || (isAuthenticated() && request.auth.uid == userId && isSafeUserCreate());
      allow update: if isAdmin() || (isAuthenticated() && isSafeUserUpdate(userId));
      allow delete: if isAdmin();
    }

    match /notifications/{docId} {
      allow read, write, delete: if isAdmin();
    }

    match /notifications/users/{userId}/{messageId} {
      allow read, write, delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    match /notifications/admin/messages/{messageId} {
      allow read, write, delete: if isAdmin();
    }

    // --- FOOD APP / ORDERS / CART / REVIEWS ---
    match /orders/{orderId} {
      // Expected fields in documents: uid/authUid/userId
      allow create: if isAuthenticated() && ownsIncoming('uid');
      allow read, update: if isAdmin() || isOwner('uid');
      allow delete: if isAdmin();
    }

    match /cart/{cartId} {
      // Some code uses cart/{uid} docs.
      allow read, write: if isAuthenticated() && (request.auth.uid == cartId || isAdmin());
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || isOwner('uid');
    }

    match /feedbackandratings/{docId} {
      allow read: if isAdmin();
      allow create: if true; // allow guests/users to submit feedback
      allow update, delete: if isAdmin();
    }

    // --- T2T WORLD ---
    // App reads/writes agent users under: T2T_world/Agents/Users/{uid}
    match /T2T_world/{docId}/{subPath=**} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // --- BOOKING COLLECTIONS ---
    match /{collection}/{docId} {
      allow create: if collection in [
        'hotelBookingData', 'travelBookingDetails', 'car_bookings',
        'self_driving_bookings', 'vanBookings'
      ] && isAuthenticated(); // Relaxed validation to ensure functionality

      allow read: if collection in [
        'hotelBookingData', 'travelBookingDetails', 'car_bookings',
        'self_driving_bookings', 'vanBookings'
      ] && (isOwner('userId') || isAdmin());

      allow update: if isAdmin() || (
        collection in ['hotelBookingData', 'travelBookingDetails', 'car_bookings', 'self_driving_bookings', 'vanBookings'] &&
        isOwner('userId')
      );
      allow delete: if isAdmin();
    }

    // --- PARTNER-OWNED SERVICE DATA ---
    match /partners/{partnerId} {
      allow read: if true;
      allow create, update: if isAdmin() || (isAuthenticated() && request.auth.uid == partnerId);
      allow delete: if isAdmin();
    }

    match /drivers/{driverId} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == driverId);
      allow create, update: if isAdmin() || (isAuthenticated() && request.auth.uid == driverId);
      allow delete: if isAdmin();
    }

    match /HotelDB/{hotelId} {
      allow read: if true;
      allow create, update: if isAdmin() || (isAuthenticated() && request.auth.uid == hotelId);
      allow delete: if isAdmin();
    }

    match /restaurants/{restaurantId} {
      allow read: if true;
      allow create, update: if isAdmin() || (isAuthenticated() && request.auth.uid == restaurantId);
      allow delete: if isAdmin();
    }

    match /foodMenu/{menuId} {
      allow read: if true;
      allow create: if isAdmin() || ownsIncoming('restaurantUid');
      allow update, delete: if isAdmin() || isOwner('restaurantUid');
    }

    match /localServices/{serviceId} {
      allow read: if true;
      allow create: if isAdmin() || ownsIncoming('providerUid');
      allow update, delete: if isAdmin() || isOwner('providerUid');
    }

    match /hotelPackageDetails/{packageId} {
      allow read: if true;
      allow create: if isAdmin() || ownsIncoming('hotelUid');
      allow update, delete: if isAdmin() || isOwner('hotelUid');
    }

    match /hotelPackages/{packageId} {
      allow read: if true;
      allow create: if isAdmin() || ownsIncoming('hotelUid');
      allow update, delete: if isAdmin() || isOwner('hotelUid');
    }

    match /allRequirements/{requirementId} {
      allow read: if isAdmin() || isOwner('providerUid');
      allow create: if isAdmin() || ownsIncoming('providerUid');
      allow update, delete: if isAdmin() || isOwner('providerUid');
    }

    match /travelRequirements/{requirementId} {
      allow read: if isAdmin() || isOwner('providerUid');
      allow create: if isAdmin() || ownsIncoming('providerUid');
      allow update, delete: if isAdmin() || isOwner('providerUid');
    }

    match /general_partners/{partnerId}/assignedPackages/{assignmentId} {
      allow read, write: if isAdmin();
    }

    match /counters/{counterId} {
      allow read, write: if isAdmin();
    }

    match /acceptedRestaurants/{restaurantId} {
      allow read, write: if isAdmin();
    }

    match /restroRequests/{restaurantId} {
      allow read, write: if isAdmin();
    }

    // --- ADMIN ONLY COLLECTIONS ---
    match /{collection}/{docId} {
      allow read, write: if isAdmin() && collection in [
        'agents', 'drivers', 'shops', 'clubs', 'allRequirements',
        'travelRequirements', 'partner_invoices', 'manage_partners',
        'general_partners', 'vanCompanies', 'settings', 'statistics',
        'hotel_statistics', 'DeletionRequests', 'counters',
        'acceptedRestaurants', 'restroRequests'
      ];
    }

    // --- EARNINGS / REVENUE TRACKING ---
    // Admin dashboard statistics + booking confirmation revenue writes.
    // Allow read/create/update only — no delete.
    match /MasterEarnings/Admin/{type}/Earnings/{earningsType}/{docId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin();
    }

    // Partner-scoped earnings (hotel, driver, etc.)
    match /MasterEarnings/{type}/{partnerId}/Earnings/{earningsType}/{docId} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == partnerId);
      allow create, update: if isAdmin() || (isAuthenticated() && request.auth.uid == partnerId);
    }

    // --- CHAT SYSTEM ---
    match /chatRooms/{roomId} {
      allow read, write: if isAuthenticated(); // Should ideally check participants
    }

    match /chats/{chatId} {
      allow read, write: if isAuthenticated();
    }

    // Some chat modules use a top-level `messages` collection.
    match /messages/{messageId} {
      allow read, write: if isAuthenticated();
    }

    // Calls / realtime calling metadata
    match /calls/{callId} {
      allow read, write: if isAuthenticated();
    }

    // Bookings used by hotel widgets
    match /bookings/{bookingId} {
      allow create: if isAuthenticated();
      allow read, update: if isAdmin() || isOwner('uid');
      allow delete: if isAdmin();
    }

    // Restaurant / dine-in booking
    match /dineInBookings/{bookingId} {
      allow create: if isAuthenticated();
      allow read, update: if isAdmin() || isOwner('uid');
      allow delete: if isAdmin();
    }

    // Self-drive conditions/docs collection referenced in app.
    match /self_drive_conditions_and_documents/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin roster/agents collection used in app
    match /agents/{agentId} {
      allow read, write: if isAdmin();
    }

    // App references RestAdmin for restaurant admin panel/data
    match /RestAdmin/{docId} {
      allow read, write: if isAdmin();
    }

    // Default: Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
